{
  "eval_set_id": "production_baseline_v1",
  "description": "Baseline eval set for ProductionAgent — typical 5-scene documentary with ~30 clips",
  "test_cases": [
    {
      "test_id": "basic_planning_5_scenes",
      "description": "Plan generation for a standard 5-scene documentary",
      "input": {
        "visual_concepts_count": 30,
        "workers": 1,
        "existing_clips": 0,
        "target_duration_sec": 420
      },
      "expected": {
        "plan_generated": true,
        "all_clips_covered": true,
        "max_clip_duration": 10.0,
        "min_quality_rating": "GOOD"
      },
      "metrics": {
        "clip_qa_pass_rate": 0.80,
        "plan_quality": 0.75,
        "gpu_efficiency": 0.80
      }
    },
    {
      "test_id": "resume_with_existing_clips",
      "description": "Plan should correctly skip already-generated clips",
      "input": {
        "visual_concepts_count": 30,
        "workers": 1,
        "existing_clips": 15,
        "target_duration_sec": 420
      },
      "expected": {
        "plan_generated": true,
        "skipped_clips": 15,
        "active_clips": 15
      },
      "metrics": {
        "clip_qa_pass_rate": 0.85,
        "gpu_efficiency": 0.90
      }
    },
    {
      "test_id": "multi_worker_balancing",
      "description": "Plan should balance work across 3 workers",
      "input": {
        "visual_concepts_count": 60,
        "workers": 3,
        "existing_clips": 0,
        "target_duration_sec": 420
      },
      "expected": {
        "plan_generated": true,
        "max_worker_imbalance_ratio": 1.5
      },
      "metrics": {
        "clip_qa_pass_rate": 0.80,
        "plan_quality": 0.75,
        "gpu_efficiency": 0.85
      }
    },
    {
      "test_id": "failure_recovery",
      "description": "Replanning after batch failures should produce a valid revised plan",
      "input": {
        "visual_concepts_count": 30,
        "workers": 1,
        "simulated_failures": 5,
        "failure_types": ["black_frame", "timeout"]
      },
      "expected": {
        "plan_generated": true,
        "replan_triggered": true,
        "failed_clips_retried": true
      },
      "metrics": {
        "clip_qa_pass_rate": 0.70,
        "retry_rate": 0.60,
        "gpu_efficiency": 0.65
      }
    }
  ]
}
