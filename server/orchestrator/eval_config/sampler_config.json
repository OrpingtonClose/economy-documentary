{
  "num_samples": 3,
  "max_iterations": 5,
  "eval_metrics": [
    "clip_qa_pass_rate",
    "duration_accuracy",
    "gpu_efficiency",
    "plan_quality",
    "retry_rate"
  ],
  "optimization_target": "clip_qa_pass_rate",
  "optimization_threshold": 0.85,
  "agents_to_optimize": [
    "production_planner",
    "production_evaluator",
    "production_replanner"
  ],
  "environment_simulation": {
    "enabled": true,
    "mock_gpu_workers": true,
    "mock_responses": {
      "video_generation": {
        "success_rate": 0.85,
        "avg_gen_time_sec": 180,
        "qa_pass_rate": 0.80
      }
    },
    "error_injection": {
      "probability": 0.10,
      "types": ["timeout", "cuda_oom", "black_frame"]
    }
  }
}
