# ── Model Configuration ─────────────────────────────────────
# Primary model (used by tool-capable agents)
# Examples:
#   ADK_MODEL=gemini-2.0-flash              (native Gemini)
#   ADK_MODEL=litellm/openai/gpt-4o         (LiteLLM routing)
#   ADK_MODEL=openai/qwen3-30b-a3b          (vLLM endpoint)
ADK_MODEL=litellm/openai/gpt-4o

# Synthesis model (optional — defaults to ADK_MODEL)
# ADK_SYNTHESIS_MODEL=openai/zai-org-glm-4.7
# SYNTHESIS_API_KEY=
# SYNTHESIS_API_BASE=https://api.venice.ai/api/v1

# Thinker model (optional — defaults to ADK_SYNTHESIS_MODEL)
# ADK_THINKER_MODEL=openai/your-thinker-model
# THINKER_API_KEY=
# THINKER_API_BASE=https://your-thinker-provider.com/v1

# Vision model (optional — defaults to ADK_MODEL, needs vision capability)
# ADK_VISION_MODEL=litellm/openai/gpt-4o
# VISION_API_KEY=
# VISION_API_BASE=

# API keys
GOOGLE_API_KEY=                   # For Gemini via ADK native
OPENAI_API_BASE=                  # vLLM or compatible endpoint
OPENAI_API_KEY=

# Venice-specific parameters (JSON dict)
# VENICE_PARAMS={"include_venice_system_prompt": false}

# ── LLM Concurrency & Context ──────────────────────────────
MAX_CONCURRENT_LLM=2
MAX_CONTEXT_TOKENS=128000
HARD_CONTEXT_LIMIT=160000
TOOL_RESULT_MAX_CHARS=25000

# ── ADK Plugin Configuration ───────────────────────────────
CONTEXT_INVOCATIONS_TO_KEEP=2
TOOL_MAX_RETRIES=2

# ── Provider Rate Limiting ──────────────────────────────────
GPU_CONCURRENCY=1
TTS_CONCURRENCY=2
VASTAI_CONCURRENCY=3

# ── Pipeline Configuration ──────────────────────────────────
DOCUMENTARY_TEST_MODE=false        # Set to "true" or "1" for test mode (no GPU needed)
# DOCUMENTARY_QUICK_TEST=false    # Set to "true" for 1-min test movie (2 scenes, ~15s each)
TIMELINE_DIR=/tmp/documentary-pipeline/timelines
TTS_OUTPUT_DIR=/tmp/documentary-pipeline/audio
VIDEO_OUTPUT_DIR=/tmp/documentary-pipeline/video

# ── GPU / Vast.ai ──────────────────────────────────────────
VAST_API_KEY=
GPU_WORKER_URL=                   # HTTP URL of GPU worker (e.g., http://host:8880)

# ── Backblaze B2 (model cache + artifact storage) ─────────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_MODELS_BUCKET=ltx2-models-orpington
B2_ARTIFACTS_BUCKET=economy-vid-assets

# ── Observability ──────────────────────────────────────────
AGENTOPS_API_KEY=
PHOENIX_ENABLED=                  # Set to "1" to stream spans to Phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
ADK_DEBUG=                        # Set to "1" for DebugLoggingPlugin
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=

# ── Dashboard ──────────────────────────────────────────────
DASHBOARD_DB_DIR=~/.documentary-pipeline
FINDINGS_DIR=~/.documentary-pipeline
