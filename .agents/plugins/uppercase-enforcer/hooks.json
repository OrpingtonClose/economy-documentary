{
  "uppercase-enforcer": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool run_command --command \"${CommandLine}\""
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool write_to_file --file \"${TargetFile}\""
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool replace_file_content --file \"${TargetFile}\""
          }
        ]
      },
      {
        "matcher": "multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool multi_replace_file_content --file \"${TargetFile}\""
          }
        ]
      },
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool view_file --file \"${AbsolutePath}\""
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool invoke_subagent"
          }
        ]
      },
      {
        "matcher": "send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool send_message"
          }
        ]
      },
      {
        "matcher": "schedule",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool schedule"
          }
        ]
      },
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/plugins/uppercase-enforcer/uppercase_enforcer.py --tool ask_question"
          }
        ]
      }
    ]
  }
}
