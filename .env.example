# Copy this to .env and fill in your credentials
# These are referenced throughout the scripts as environment variables

# HuggingFace — for downloading Gemma-3-12B and LTX-2.3 models
HF_TOKEN=hf_your_token_here

# Vast.ai — for renting GPU VMs
VAST_API_KEY=your_vast_ai_api_key

# Backblaze B2 — for video storage
B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_app_key

# Frame.io V4 (Adobe IMS) — for review platform (optional)
FRAMEIO_CLIENT_ID=your_frameio_client_id
FRAMEIO_CLIENT_SECRET=your_frameio_client_secret
FRAMEIO_ACCOUNT_ID=your_frameio_account_id

# Apify — for YouTube transcript scraping (optional, corpus building only)
APIFY_TOKEN=your_apify_token

# YouTube Data API — for channel discovery (optional, corpus building only)
YOUTUBE_API_KEY=your_youtube_api_key
